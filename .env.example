# =============================================================
# Marktvision Leads IA — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# =============================================================

# --- Banco de dados (PostgreSQL 16+) --------------------------
# Papel da APLICAÇÃO: não-superusuário, sujeito a RLS (isolamento por empresa)
DATABASE_URL=postgres://mv_app:SENHA_APP@localhost:5432/marktvision
# Papel DONO do schema: usado apenas para migrações e seed
DATABASE_OWNER_URL=postgres://mv_owner:SENHA_OWNER@localhost:5432/marktvision
# Banco usado pelos testes automatizados (será apagado e recriado)
TEST_DATABASE_URL=postgres://mv_app:SENHA_APP@localhost:5432/marktvision_test
TEST_DATABASE_OWNER_URL=postgres://mv_owner:SENHA_OWNER@localhost:5432/marktvision_test

# --- Segurança ------------------------------------------------
# Chave de 32 bytes em base64 para criptografar tokens de integrações
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# true em produção (HTTPS) para cookies "Secure"
COOKIE_SECURE=false

# --- Administrador geral inicial (usado por npm run db:seed) ---
PLATFORM_ADMIN_NAME=Administrador Marktvision
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=

# --- Integrações (Fases 03, 05 e 08) --------------------------
# Google Places API (New): https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=
# Meta WhatsApp Business Platform (Cloud API)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# ID da configuração "Facebook Login for Business" (Embedded Signup) do app da Marktvision
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v27.0
# Inteligência artificial — escolha UM provedor (ver MANUAL_INSTALACAO.md, seção IA)
#  Anthropic (pago):           ANTHROPIC_API_KEY=...  (AI_MODEL padrão claude-opus-5-5)
#  Gemini (franquia gratuita): AI_PROVIDER=openai_compat AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_API_KEY=... AI_MODEL=gemini-2.5-flash
#  Groq (franquia gratuita):   AI_PROVIDER=openai_compat AI_BASE_URL=https://api.groq.com/openai/v1 AI_API_KEY=... AI_MODEL=llama-3.3-70b-versatile
#  Ollama (local, gratuito):   AI_PROVIDER=openai_compat AI_BASE_URL=http://ollama:11434/v1 AI_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Pesquisa de empresas: osm (OpenStreetMap, gratuito) ou google (requer GOOGLE_PLACES_API_KEY)
SEARCH_PROVIDER=

# URL pública da aplicação (webhooks)
APP_URL=http://localhost:3000
